{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "antibody hook user-prompt --agent claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "antibody hook session-end --agent claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
